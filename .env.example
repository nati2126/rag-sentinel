# Copy to .env and adjust. All settings use the SENTINEL_ prefix (see src/rag_sentinel/config.py).

# Where SQLite, Qdrant and stored files live
SENTINEL_DATA_DIR=data/kb

# Ollama (models are pulled into OLLAMA_MODELS; set that env var to a large drive before `ollama pull`)
SENTINEL_OLLAMA_URL=http://127.0.0.1:11434
SENTINEL_LLM_MODEL=qwen2.5:7b-instruct
SENTINEL_EMBED_MODEL=nomic-embed-text

# Cross-encoder reranker (Hugging Face). HF_HOME decides where weights are cached.
SENTINEL_RERANKER_MODEL=BAAI/bge-reranker-base
SENTINEL_RERANKER_DEVICE=cpu
SENTINEL_HF_HOME=D:/models/hf
# Set to false once to allow downloading the reranker, then back to true
SENTINEL_HF_OFFLINE=true

# Fixed reference date for "in force" decisions (leave empty for today)
# SENTINEL_AS_OF=2026-10-01

# Ranking weights (nested settings use __)
# SENTINEL_RANKING__RELEVANCE=0.45
# SENTINEL_RANKING__AUTHORITY=0.25

SENTINEL_API_URL=http://127.0.0.1:8000
SENTINEL_LOG_LEVEL=INFO
